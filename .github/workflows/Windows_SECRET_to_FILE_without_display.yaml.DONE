name: try-uninstall-PGWin
run-name: Try uninstall PGWIN

on:
   push:
   pull_request:
   workflow_dispatch:

jobs:
  job1:
    name: Job 1
    runs-on: windows-latest

    steps:
    - name: Checkout code
      uses: actions/checkout@v6

    - name:  Step 1
      shell: cmd
      run: |
        echo on
        echo LIST OF THE HUMAN-READABLE NAMES
        sc query state= all | find "DISPLAY_NAME"
