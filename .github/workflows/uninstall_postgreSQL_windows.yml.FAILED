
on: [push]

jobs:

  destroy-PG-on-GA-win-image:
    runs-on: windows-latest

    steps:

    - name: Diplay the default Windows PostgreSQL Server service
      shell: cmd
      run: |
        echo on
        rem list of the human-readable names
        sc query state= all | find "DISPLAY_NAME"
        rem DISPLAY_NAME: postgresql-x64-17 - PostgreSQL Server 17


    - name: Start PostgreSQL for Windows
      env:
        PGVER2: 17
        Platform: x64
      shell: cmd
      run: |
        echo on
        if "%Platform%"=="x64" (net start postgresql-x64-%PGVER2%)
        if "%Platform%"=="x86" (net start postgresql-%PGVER2%)
        if "%Platform%"=="notset" (echo Platform is not set, therefore no net start happens.)


    - name: Stop PostgreSQL for Windows
      env:
        PGVER2: 17
        Platform: x64
      shell: cmd
      run: |
        echo on
        if "%Platform%"=="x64" (net stop postgresql-x64-%PGVER2%)
        if "%Platform%"=="x86" (net stop postgresql-%PGVER2%)
        if "%Platform%"=="notset" (echo Platform is not set, therefore no net stop happens.)



    - name: Gather facts about the default Windows PostgreSQL Server service
      shell: powershell
      run: |
        function Set-EnvVar {param($X)     Add-Content -Path ${env:GITHUB_ENV} -Value "$X"}

        # Get-Service

        # inheriting
        ${env:Platform} = "x64"
        Set-EnvVar "Platform=${env:Platform}"
        echo "Platform: ${env:Platform}"
        
        ${env:PlatformPGAdj} = "notset"
        ${env:PlatformSVCAdj} = "notset"
        # "C:\Program Files (x86)"
        if ("${env:Platform}" -eq "x86") { ${env:PlatformPGAdj} = " (x86)" } else { ${env:PlatformPGAdj} = "" }
        #  x64 PostgreSQL service names on windows
        if ("${env:Platform}" -eq "x64") { ${env:PlatformSVCAdj} = "-x64"  } else { ${env:PlatformSVCAdj} = "" }

        Set-EnvVar "PlatformPGAdj=${env:PlatformPGAdj}"
        echo "PlatformPGAdj: ${env:PlatformPGAdj}"

        Set-EnvVar "PlatformSVCAdj=${env:PlatformSVCAdj}"
        echo "PlatformSVCAdj: ${env:PlatformSVCAdj}"

        ${env:pgWINServiceNameHostDefault} = "notset"
        ${env:pgWINServiceNameHostDefault} = (Get-Service -ErrorAction SilentlyContinue | where-object {$_.name -like "*postgres*"}).Name
        if ("${env:pgWINServiceNameHostDefault}" -eq "") { ${env:pgWINServiceNameHostDefault} = "none" }
        Set-EnvVar "pgWINServiceNameHostDefault=${env:pgWINServiceNameHostDefault}"
        
        echo "pgWINServiceNameHostDefault: ${env:pgWINServiceNameHostDefault}"

        ${env:pgWINServiceExists} = "notset"
        if("${env:pgWINServiceNameHostDefault}" -eq "none") {${env:pgWINServiceExists} = "false"} else {${env:pgWINServiceExists} = "true"}
        Set-EnvVar "pgWINServiceExists=${env:pgWINServiceExists}"
        
        echo "pgWINServiceExists: ${env:pgWINServiceExists}"

        ${env:pgwinmajor} = "notset"
        if("${env:pgWINServiceExists}" -eq "true") {
          echo "pgWINServiceNameHostDefault: ${env:pgWINServiceNameHostDefault}"
          # 1-30 seconds - silently fails
          Stop-Service  -Name "${env:pgWINServiceNameHostDefault}"
          $matches = @()
          "${env:pgWINServiceNameHostDefault}" -match "(\d+[.]{0,1}\d+$)"
          ${env:pgwinmajor} = $matches[1]
          $matches = @()
        } else {
          ${env:pgwinmajor} = "none"
        }
        Set-EnvVar "pgwinmajor=${env:pgwinmajor}"
        echo "pgwinmajor: ${env:pgwinmajor}"

        # PRESS FOR A NEW CONTROLLABLE 17

        # supplied in the matrix
        ${env:pgWINversion} = "17.11-1"
        
        echo "pgWINversion: ${env:pgWINversion}"

        ${env:pgWINversionlong} = "notset"

        if("${env:Platform}" -eq "x64" -and "${env:pgWINversion}" -ne "notset") {
          ${env:pgWINversionlong} = "postgresql-${env:pgWINversion}-windows-x64"
        }
        if("${env:Platform}" -eq "notset" -or "${env:pgWINversion}" -eq "notset") {
          ${env:pgWINversionlong} = "notset"
        }
        Set-EnvVar "pgWINversionlong=${env:pgWINversionlong}"

        echo "pgWINversionlong: ${env:pgWINversionlong}"

        if("${env:pgWINversionlong}" -ne "notset") {
          ${env:ENTDB_PG_DOWNLOAD_URL} = "http://get.enterprisedb.com/postgresql/${env:pgWINversionlong}.exe"
        }
        if("${env:pgWINversionlong}" -eq "notset") {
          ${env:ENTDB_PG_DOWNLOAD_URL} = "notset"
        }
        Set-EnvVar "ENTDB_PG_DOWNLOAD_URL=${env:ENTDB_PG_DOWNLOAD_URL}"

        echo "ENTDB_PG_DOWNLOAD_URL: ${env:ENTDB_PG_DOWNLOAD_URL}"


    - name: Remove the default Windows PostgreSQL Server service (except for the registry)
      if: ${{ env.pgWINServiceExists == 'true' }}
      shell: bash
      run: |
        echo "See all services"
        net start
        echo "Uninstalling Service Software (only if from EDB)"
        # uninstall-postgresql.exe
        export POSTGRES_PATH="$(cygpath "C:\Program Files\\${PlatformPGAdj}\PostgreSQL")"
        echo "POSTGRES_PATH: ${POSTGRES_PATH}"
        export UNINSTALLER_PATH="$(cygpath "${POSTGRES_PATH}\\${pgwinmajor}")"
        echo "UNINSTALLER_PATH: ${UNINSTALLER_PATH}"
        export UNINSTALLER_PATH_FILE="$(cygpath "${UNINSTALLER_PATH}\uninstall-postgresql.exe")"
        echo "UNINSTALLER_PATH_FILE: ${UNINSTALLER_PATH_FILE}"
        echo "Investigating possible potential UNINSTALLER: ${UNINSTALLER_PATH_FILE}"
        if [ -f "${UNINSTALLER_PATH_FILE}" ]
        then
          echo "UNINSTALLER found"
          ls -alrt "${UNINSTALLER_PATH_FILE}"
          # silently does NOT WORK
          "${UNINSTALLER_PATH_FILE}" --debuglevel 3 --mode unattended
          echo After attempted uninstallation ...
          ls -alrt "${UNINSTALLER_PATH}"
        else
          echo "UNINSTALLER not found.  This was not an EDB PostgreSQL database."
        fi
        
        # ServiceName  postgresql-x64-17
        # Version  17.10
        # ServiceStatus  Stopped
        # ServiceStartType  Disabled
        # https://github.com/actions/runner-images/blob/main/images/windows/Windows2025-VS2026-Readme.md
        
        # echo "Attempting - enabling"
        # # enabling required before any stop or start attempt
        # sc config "${pgWINServiceNameHostDefault}" start=auto
        # echo "Attempting - net stop"
        # net start "${pgWINServiceNameHostDefault}"
        # # error below if the service is not started
        # # echo "Attempting - sc stop"
        # sc stop "${pgWINServiceNameHostDefault}"
        echo "See the service"
        sc query state= all | grep postgres | echo ""
        sc query                "${pgWINServiceNameHostDefault}"
        echo "Deleting Service - ${pgWINServiceNameHostDefault}"
        sc delete               "${pgWINServiceNameHostDefault}"
        echo "See the service"
        sc query state= all | grep postgres | echo ""

        echo "Manually Deleting Files and the Directory"
        rm -Rf   "${UNINSTALLER_PATH}"
        echo "After Manually Deleting Files and the Directory"
        ls -alrt "${POSTGRES_PATH}"
 
    - name: Remove the default Windows PostgreSQL Server service registry entry
      if: ${{ env.pgWINServiceExists == 'true' }}
      shell: powershell
      run: |
        echo Removing registry entry
        Remove-Item -Path "HKLM:\SOFTWARE\PostgreSQL" -Recurse -Force
        echo Removing the service registry entry
        # Cannot delete a subkey tree because the subkey does not exist
        # Remove-Item -Path "HKLM:\SYSTEM\CurrentControlSet\Services\${env:pgWINServiceNameHostDefault}" -Recurse -Force

    - name: Download PostgreSQL for Windows
      uses: suisei-cn/actions-download-file@v1.6.1
      with:
        url: ${{ env.ENTDB_PG_DOWNLOAD_URL }}

    - name: Install PostgreSQL for Windows and Stop PostgreSQL
      shell: cmd
      run: |
        echo on
        "${{ env.pgWINversionlong }}.exe" --unattendedmodeui none --mode unattended --enable-components server,commandlinetools --disable-components pgAdmin,stackbuilder --superpassword "root" > nul
        rem Installation will also start PostgreSQL
        echo "See all services (that haves a display)"
        net start

    - name: Stop PostgreSQL for Windows
      env:
        PGVER2: 17
        Platform: x64
      shell: cmd
      run: |
        echo on
        if "%Platform%"=="x64" (net stop postgresql-x64-%PGVER2%)
        if "%Platform%"=="x86" (net stop postgresql-%PGVER2%)
        if "%Platform%"=="notset" (echo Platform is not set, therefore no net stop happens.)


    - name: Start PostgreSQL for Windows
      env:
        PGVER2: 17
        Platform: x64
      shell: cmd
      run: |
        echo on
        if "%Platform%"=="x64" (net start postgresql-x64-%PGVER2%)
        if "%Platform%"=="x86" (net start postgresql-%PGVER2%)
        if "%Platform%"=="notset" (echo Platform is not set, therefore no net start happens.)
